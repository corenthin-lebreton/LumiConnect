NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement des secrets stockes en base (vm_password, guac_password).
# Generer: openssl rand -base64 32
LC_ENCRYPTION_KEY=

# URL de base uniquement, sans chemin : le code ajoute lui-meme /api2/json.
# Correct   : https://prx.example.com        (ou https://10.0.0.5:8006)
# Incorrect : https://prx.example.com/api2/json  -> appelle /api2/json/api2/json, HTTP 501
PROXMOX_URL=
# Forme complete user@realm!nomdutoken, ex. lumiconnect@pve!deploy
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=

PFSENSE_URL=
PFSENSE_API_KEY=
PFSENSE_API_SECRET=

GUACAMOLE_URL=
GUACAMOLE_ADMIN_USER=
GUACAMOLE_ADMIN_PASSWORD=
GUACAMOLE_DATASOURCE= # identifiant dans availableDataSources ("postgresql" pour guacamole-auth-jdbc-postgresql), jamais "postgres"

# Boucle de traitement des jobs (deploy/cleanup), interne au process du serveur
LC_WORKER_POLL_MS=3000
LC_WORKER_HEARTBEAT_MS=30000
LC_WORKER_STALE_AFTER=00:05:00

# Nombre de VMs traitees simultanement. Les clones sont brefs, la configuration in-guest
# occupe une VM pendant des dizaines de minutes : d'ou deux limites distinctes.
LC_CLONE_CONCURRENCY=8
LC_CONFIGURE_CONCURRENCY=4

# Delai d'attente du QEMU guest agent apres demarrage d'une VM, en secondes.
# Un premier demarrage Windows peut demander plusieurs minutes.
LC_AGENT_TIMEOUT_SEC=600

# Pause apres le premier ping guest-agent reussi, avant le premier guest-exec. Le ping
# repond avant que l'agent soit fiable pour exec pendant le boot storm Windows.
LC_AGENT_SETTLE_SEC=90
