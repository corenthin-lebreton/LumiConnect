NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement des secrets stockes en base (vm_password, guac_password).
# Generer: openssl rand -base64 32
LC_ENCRYPTION_KEY=

# Proxmox, pfSense et Guacamole ne se configurent plus ici : page Parametres de l'application
# (groupes d'infrastructure, secrets chiffres en base avec LC_ENCRYPTION_KEY).
# Pour reprendre une configuration .env existante une seule fois : pnpm seed:group -- --name "Nom"

# Boucle de traitement des jobs (deploy/cleanup), interne au process du serveur
LC_WORKER_POLL_MS=3000
LC_WORKER_HEARTBEAT_MS=30000
LC_WORKER_STALE_AFTER=00:05:00

# Clones lies depuis l'image doree : Proxmox verrouille le template pendant chaque clone, les
# clones paralleles se disputent le verrou. 1 = sequentiel (3 a 5 s par clone), retry automatique
# sur verrou dans tous les cas.
LC_CLONE_CONCURRENCY=1
# VMs traitees simultanement apres clonage (demarrage, identite, IP, Guacamole). Limite le boot
# storm sur l'hote.
LC_CONFIGURE_CONCURRENCY=4

# Delai d'attente du QEMU guest agent apres demarrage d'une VM, en secondes.
# Un premier demarrage Windows peut demander plusieurs minutes.
LC_AGENT_TIMEOUT_SEC=600

# Pause apres le premier ping guest-agent reussi, avant le premier guest-exec. Le ping
# repond avant que l'agent soit fiable pour exec pendant le boot storm Windows.
LC_AGENT_SETTLE_SEC=90
