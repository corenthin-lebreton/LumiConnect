{"nodes": [{"id": "services_proxmox_agent_startvm", "label": "startVm", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L60-73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_rebootvm", "label": "rebootVm", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L75-85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_waitforagent", "label": "waitForAgent (poll agent/ping)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L90-113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "agent/ping \u00e9choue tant que qemu-guest-agent n'a pas d\u00e9marr\u00e9 dans l'invit\u00e9 : c'est le seul signal fiable qu'une commande peut \u00eatre envoy\u00e9e. Sur un premier d\u00e9marrage Windows, compter plusieurs minutes."}, {"id": "services_proxmox_agent_guestfilewrite", "label": "guestFileWrite (agent/file-write)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L115-135", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_file_write_max_chars", "label": "Limite agent/file-write 60 Ko", "file_type": "concept", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L9-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proxmox refuse un file-write au-del\u00e0 de 61440 caract\u00e8res. Un m\u00e9canisme de chunking a \u00e9t\u00e9 \u00e9cart\u00e9 : aucun script de configuration ne s'en approche, mieux vaut \u00e9chouer avec un message clair que construire un d\u00e9coupage dont personne n'a besoin."}, {"id": "services_proxmox_agent_guestexec", "label": "guestExec (agent/exec, argv array)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L137-152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`command` est r\u00e9p\u00e9t\u00e9 une fois par argument : c'est un tableau c\u00f4t\u00e9 API, jamais une ligne de commande \u00e0 d\u00e9couper. Aucun shell interm\u00e9diaire ne r\u00e9interpr\u00e8te les arguments."}, {"id": "services_proxmox_agent_guestexecstatus", "label": "guestExecStatus (agent/exec-status)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L162-183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_waitforexec", "label": "waitForExec (poll until exited)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L226-268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Au d\u00e9passement du timeout le processus continue de tourner dans l'invit\u00e9 : le guest agent n'offre aucun moyen de le tuer, l'\u00e9tape est donc marqu\u00e9e en \u00e9chec en signalant le pid laiss\u00e9 en ex\u00e9cution."}, {"id": "services_proxmox_agent_runguestcommand", "label": "runGuestCommand", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L275-284", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_runguestscript", "label": "runGuestScript (write then exec)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L286-300", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_interpretercommand", "label": "interpreterCommand (powershell.exe / bin bash)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L205-218", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_proxmox_agent_withpowershellbom", "label": "withPowerShellBom", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L220-224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PowerShell 5.1 lit un .ps1 sans BOM comme de l'ANSI : sans BOM, tout accent dans un script casse \u00e0 l'ex\u00e9cution."}, {"id": "services_proxmox_agent_waitfortask", "label": "waitForTask (agent module)", "file_type": "code", "source_file": "lib/services/proxmox-agent.ts", "source_location": "L45-58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "external_qemu_guest_agent", "label": "QEMU guest agent (dans l'invit\u00e9)", "file_type": "concept", "source_file": "lib/services/proxmox-agent.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "services_proxmox_agent_startvm", "target": "external_proxmox_rest_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/services/proxmox-agent.ts", "source_location": "L62-68", "weight": 1.0}, {"source": "services_proxmox_agent_guestexec", "target": "external_qemu_guest_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/services/proxmox-agent.ts", "source_location": "L147", "weight": 1.0}, {"source": "services_proxmox_agent_guestfilewrite", "target": "external_qemu_guest_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/services/proxmox-agent.ts", "source_location": "L128", "weight": 1.0}, {"source": "services_proxmox_agent_waitforagent", "target": "external_qemu_guest_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/services/proxmox-agent.ts", "source_location": "L99", "weight": 1.0}, {"source": "services_proxmox_agent_runguestscript", "target": "servic