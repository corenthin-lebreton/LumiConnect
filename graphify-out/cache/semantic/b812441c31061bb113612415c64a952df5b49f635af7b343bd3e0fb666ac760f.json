{"nodes": [{"id": "lib_cleanup_deleteformation", "label": "deleteFormation Teardown", "file_type": "code", "source_file": "lib/cleanup.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teardown order is Guacamole users, then groups, then pfSense leases, then Proxmox VMs, then the DB row. Group ids fall back to findByName when the DB never recorded them, and individual connections are deleted defensively if the connection-group cascade fails. Any failure leaves the row in cleanup_failed with the accumulated messages instead of deleting it, so nothing is orphaned silently."}], "edges": [{"source": "lib_cleanup_deleteformation", "target": "services_guacamole_deleteuser", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/cleanup.ts", "source_location": null, "weight": 1.0}, {"source": "lib_cleanup_deleteformation", "target": "services_guacamole_deleteusergroup", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/cleanup.ts", "source_location": null, "weight": 1.0}, {"source": "lib_cleanup_deleteformation", "target": "services_guacamole_deleteconnectiongroup", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/cleanup.ts", "source_location": null, "weight": 1.0}, {"source": "lib_cleanup_deleteformation", "target": "services_pfsense_deletedhcpleasesbulk", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/cleanup.ts", "source_location": null, "weight": 1.0}, {"source": "lib_cleanup_deleteformation", "target": "services_proxmox_deletevm", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/cleanup.ts", "source_location": null, "weight": 1.0}, {"source": "lib_cleanup_deleteformation", "target": "db_formation_vms_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score":