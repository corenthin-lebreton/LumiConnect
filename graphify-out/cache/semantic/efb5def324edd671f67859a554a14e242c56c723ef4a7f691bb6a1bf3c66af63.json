{"nodes": [{"id": "scripts_escape_injection_boundary", "label": "Fronti\u00e8re d'injection shell du produit", "file_type": "concept", "source_file": "lib/scripts/escape.ts", "source_location": "L3-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Les valeurs viennent du formulaire de cr\u00e9ation de formation et finissent dans un fichier interpr\u00e9t\u00e9 par un shell, en SYSTEM/root, sur chaque VM. Tout passe par ce module, jamais par concat\u00e9nation directe."}, {"id": "scripts_escape_escapepowershell", "label": "escapePowerShell", "file_type": "code", "source_file": "lib/scripts/escape.ts", "source_location": "L9-11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dans une cha\u00eene simple-quote PowerShell, seule l'apostrophe est sp\u00e9ciale et s'\u00e9chappe en la doublant ; ni $, ni backtick, ni guillemet n'y sont interpr\u00e9t\u00e9s."}, {"id": "scripts_escape_escapebash", "label": "escapeBash", "file_type": "code", "source_file": "lib/scripts/escape.ts", "source_location": "L15-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dans une cha\u00eene simple-quote bash rien n'est interpr\u00e9t\u00e9 et l'apostrophe ne peut pas y \u00eatre \u00e9chapp\u00e9e : il faut fermer la cha\u00eene, ins\u00e9rer une apostrophe litt\u00e9rale, puis rouvrir."}, {"id": "scripts_escape_escapefor", "label": "escapeFor (dispatch par shell)", "file_type": "code", "source_file": "lib/scripts/escape.ts", "source_location": "L19-21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_escape_assertsingleline", "label": "assertSingleLine (refus CR/LF et octet nul)", "file_type": "code", "source_file": "lib/scripts/escape.ts", "source_location": "L23-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un retour \u00e0 la ligne couperait la ligne d'affectation en deux et transformerait la suite en commande. Les guillemets simples prot\u00e8gent le contenu mais pas le saut de ligne : la valeur est refus\u00e9e plut\u00f4t que tronqu\u00e9e silencieusement."}, {"id": "scripts_escape_rendercontextfile", "label": "renderContextFile (contexte LC_*)", "file_type": "code", "source_file": "lib/scripts/escape.ts", "source_location": "L37-56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Les noms de variables sont contraints au motif LC_[A-Z0-9_]+, les valeurs \u00e9chapp\u00e9es par shell, et le fichier PowerShell est \u00e9crit en CRLF."}], "edges": [{"source": "scripts_escape_rendercontextfile", "target": "scripts_escape_escapepowershell", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L47", "weight": 1.0}, {"source": "scripts_escape_rendercontextfile", "target": "scripts_escape_escapebash", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L52", "weight": 1.0}, {"source": "scripts_escape_rendercontextfile", "target": "scripts_escape_assertsingleline", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L43", "weight": 1.0}, {"source": "scripts_escape_escapefor", "target": "scripts_escape_escapepowershell", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L20", "weight": 1.0}, {"source": "scripts_escape_escapefor", "target": "scripts_escape_escapebash", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L20", "weight": 1.0}, {"source": "scripts_escape_rendercontextfile", "target": "scripts_escape_injection_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L3-5", "weight": 1.0}, {"source": "scripts_escape_escapepowershell", "target": "scripts_escape_injection_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L3-11", "weight": 1.0}, {"source": "scripts_escape_escapebash", "target": "scripts_escape_injection_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts", "source_location": "L3-17", "weight": 1.0}, {"source": "scripts_escape_escapepowershell", "target": "scripts_escape_escapebash", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "lib/scripts/escape.ts", "source_location": "L7-17", "weight": 1.0}], "hyperedges": [{"id": "shell_injection_boundary", "label": "Fronti\u00e8re d'injection : valeurs du formulaire ex\u00e9cut\u00e9es en SYSTEM/root", "nodes": ["scripts_escape_injection_boundary", "scripts_escape_escapepowershell", "scripts_escape_escapebash", "scripts_escape_assertsingleline", "scripts_escape_rendercontextfile", "scripts_escape_test_suite", "pipeline_configure_vm_context_file"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "lib/scripts/escape.ts"}]}